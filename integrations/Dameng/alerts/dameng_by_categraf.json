[
    {
        "cate": "prometheus",
        "name": "Dameng 指标采集耗时过长",
        "note": "采集耗时过长反映数据库响应慢，可能导致监控数据延迟",
        "prod": "metric",
        "delay": 0,
        "prom_for_duration": 90,
        "rule_config": {
            "queries": [
                {
                    "prom_ql": "dmdb_scrape_use_seconds \u003e 5",
                    "severity": 3,
                    "unit": "s"
                }
            ],
            "version": "v1"
        },
        "event_relabel_config": null,
        "prom_eval_interval": 15,
        "enable_in_bg": 0,
        "notify_recovered": 1,
        "notify_repeat_step": 10,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "summary": "采集达梦指标的耗时超过 5 秒，通常说明数据库本身已经很慢或连接受阻，采集数据也会开始失真。",
            "action": "1) 用达梦客户端手工执行一条简单查询确认响应速度；2) 查 V$SESSIONS 与 V$LOCK 看是否有大量会话堆积或锁等待；3) 确认采集账号的连接数配额与网络到数据库的延迟；4) 数据库确实繁忙则按慢查询路径排查，采集侧可适当拉长 interval 避免加重负担。"
        },
        "uuid": 1751791234000029,
        "cur_event_count": 0,
        "cron_pattern": "@every 60s",
        "notify_rule_ids": [],
        "pipeline_configs": null,
        "notify_version": 1
    },
    {
        "cate": "prometheus",
        "name": "Dameng 数据库down",
        "note": "",
        "prod": "metric",
        "delay": 0,
        "prom_for_duration": 0,
        "rule_config": {
            "queries": [
                {
                    "prom_ql": "dmdb_up != 1",
                    "severity": 1,
                    "unit": "none"
                }
            ],
            "version": "v1"
        },
        "event_relabel_config": null,
        "prom_eval_interval": 15,
        "enable_in_bg": 0,
        "notify_recovered": 1,
        "notify_repeat_step": 10,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "summary": "采集端已连不上达梦数据库，实例可能已崩溃或网络不通，依赖该库的业务全部不可用。",
            "action": "1) 登录主机确认 dmserver 进程是否存活；2) 进程存活则用 disql 手工连一次，区分实例夯住与网络/账号问题；3) 进程不在则先看 dm_\u003c实例\u003e.log 日志尾部定位原因（磁盘满、内存不足、数据文件损坏）再拉起；4) 有主备的立即评估是否需要切换。"
        },
        "uuid": 1751791234000030,
        "cur_event_count": 0,
        "cron_pattern": "@every 60s",
        "notify_rule_ids": [],
        "pipeline_configs": null,
        "notify_version": 1
    },
    {
        "cate": "prometheus",
        "name": "Dameng 缓存命中率过低",
        "note": "缓存命中率低于95%会导致大量磁盘IO，性能下降",
        "prod": "metric",
        "delay": 0,
        "prom_for_duration": 900,
        "rule_config": {
            "queries": [
                {
                    "prom_ql": "dmdb_cache_hit_rate \u003c 95",
                    "severity": 3,
                    "unit": "%"
                }
            ],
            "version": "v1"
        },
        "event_relabel_config": null,
        "prom_eval_interval": 15,
        "enable_in_bg": 0,
        "notify_recovered": 1,
        "notify_repeat_step": 10,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "summary": "达梦数据缓冲区命中率低于 95%，大量数据块要从磁盘读取，查询延迟和磁盘 IO 都会明显上升。",
            "action": "1) 先排除刚重启导致的缓存冷启动；2) 查 V$BUFFERPOOL 确认各缓冲池的命中率与大小；3) 调大 dm.ini 里的 BUFFER 参数（通常设为物理内存的一定比例）后重启生效；4) 同时排查是否有全表扫描的 SQL 把缓存冲掉，补索引消除。"
        },
        "uuid": 1751791234000031,
        "cur_event_count": 0,
        "cron_pattern": "@every 60s",
        "notify_rule_ids": [],
        "pipeline_configs": null,
        "notify_version": 1
    },
    {
        "cate": "prometheus",
        "name": "Dameng 锁等待线程数异常",
        "note": "存在轻量级锁竞争，会导致SQL执行延迟",
        "prod": "metric",
        "delay": 0,
        "prom_for_duration": 180,
        "rule_config": {
            "queries": [
                {
                    "prom_ql": "dmdb_latches_threads \u003e 10",
                    "severity": 3,
                    "unit": "none"
                }
            ],
            "version": "v1"
        },
        "event_relabel_config": null,
        "prom_eval_interval": 15,
        "enable_in_bg": 0,
        "notify_recovered": 1,
        "notify_repeat_step": 10,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "summary": "达梦锁等待线程数超过 10，说明有事务长时间持锁，其他事务被阻塞排队，业务会出现大面积超时。",
            "action": "1) 查 V$LOCK 与 V$SESSIONS 关联，找出持锁最久的会话及其执行的 SQL；2) 确认是长事务未提交还是热点行更新冲突；3) 应急可对阻塞源头会话执行 SP_CLOSE_SESSION 释放锁；4) 根因侧缩短事务长度、统一加锁顺序，热点行考虑改为队列串行处理。"
        },
        "uuid": 1751791234000032,
        "cur_event_count": 0,
        "cron_pattern": "@every 60s",
        "notify_rule_ids": [],
        "pipeline_configs": null,
        "notify_version": 1
    }
]
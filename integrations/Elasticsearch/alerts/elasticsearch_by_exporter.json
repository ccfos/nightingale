        "annotations": {
            "summary": "数据节点可用磁盘不足 10%，已越过 flood-stage watermark，Elasticsearch 会把索引置为只读，写入全部失败。",
            "action": "1) 用 GET _cat/allocation?v 定位磁盘吃紧的节点；2) 删除或归档过期索引（DELETE \u003cindex\u003e），或用 ILM 把冷数据迁到冷节点；3) 磁盘释放后手工解除只读：PUT _all/_settings {\"index.blocks.read_only_allow_delete\":null}；4) 长期需扩容磁盘或增加数据节点。",
            "runbook_url": "https://www.elastic.co/guide/en/elasticsearch/reference/current/fix-watermark-errors.html"
        },
        "extra_config": null,
        "create_at": 0,

        "annotations": {
            "summary": "集群健康状态为 red，至少有一个主分片不可用，对应索引的读写会直接失败，并存在数据丢失风险。",
            "action": "1) 用 GET _cluster/health?level=indices 定位处于 red 的索引；2) 用 GET _cluster/allocation/explain 看主分片无法分配的具体原因；3) 常见原因是节点掉线，先把节点拉回集群让分片自动恢复；4) 节点数据确实损坏时，用 POST _snapshot/\u003crepo\u003e/\u003csnap\u003e/_restore 从快照恢复该索引。",
            "runbook_url": "https://www.elastic.co/guide/en/elasticsearch/reference/current/red-yellow-cluster-status.html"
        },
        "extra_config": null,
        "create_at": 0,
        "create_by": "",

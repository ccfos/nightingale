            "alertname=PhpfpmMaxChildrenReached"
        ],
        "annotations": {
            "summary": "PHP-FPM 进程池已经达到 pm.max_children 上限，新请求只能排队等待空闲进程，前端会直接表现为 502/504。",
            "action": "1) 从告警标签取 pool，执行 grep -i 'server reached pm.max_children' /var/log/php-fpm.log 确认发生频次；2) 用 ps --no-headers -o rss -C php-fpm | awk '{s+=$1} END {print s/NR/1024\" MB\"}' 算出单进程平均内存，再用 可用内存/单进程内存 反推安全的 max_children 值；3) 按算出的值调大 pm.max_children 并 systemctl reload php-fpm，不要盲目调大导致 OOM；4) 若单进程内存或耗时异常，去 slowlog 里定位慢脚本，从根因上减少并发占用。",
            "runbook_url": "https://www.php.net/manual/en/install.fpm.configuration.php"
        },
        "extra_config": null,
        "create_at": 0,

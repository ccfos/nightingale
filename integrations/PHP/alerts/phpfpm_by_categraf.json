            "alertname=PhpfpmMaxChildrenReached"
        ],
        "annotations": {
            "action": "1) 从告警标签取 pool，执行 grep -i 'server reached pm.max_children' /var/log/php-fpm.log 确认发生频次；\n2) 用 ps --no-headers -o rss -C php-fpm | awk '{s+=$1} END {print s/NR/1024\" MB\"}' 算出单进程平均内存，再用 可用内存/单进程内存 反推安全的 max_children 值；\n3) 按算出的值调大 pm.max_children 并 systemctl reload php-fpm，不要盲目调大导致 OOM；\n4) 若单进程内存或耗时异常，去 slowlog 里定位慢脚本，从根因上减少并发占用。"
        },
        "extra_config": null,
        "create_at": 0,
        "create_by": "",
        "update_at": 0,

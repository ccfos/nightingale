            "alertname=OpenstackNeutronAgentDown"
        ],
        "annotations": {
            "action": "1) 从告警标签取 agent_host 与 agent_type，执行 openstack network agent list 确认状态；\n2) 登录该节点执行 systemctl status neutron-openvswitch-agent（或对应 agent）查看进程与日志；\n3) 进程存活但心跳超时的，检查该节点到消息队列（RabbitMQ）的连通性，agent 心跳走 RPC，MQ 不通是最常见原因；\n4) 恢复后执行 openstack network agent list 确认 alive 变为 True，并抽查一台该节点上的虚拟机网络是否正常。"
        },
        "extra_config": null,

[
    {
        "cate": "prometheus",
        "name": "GPU XID 错误",
        "note": "xid错误码信息: https://docs.nvidia.com/deploy/xid-errors/analyzing-xid-catalog.html",
        "prod": "metric",
        "delay": 0,
        "prom_for_duration": 180,
        "rule_config": {
            "queries": [
                {
                    "prom_ql": "DCGM_FI_DEV_XID_ERRORS == 32 or DCGM_FI_DEV_XID_ERRORS == 38 or DCGM_FI_DEV_XID_ERRORS == 48 or DCGM_FI_DEV_XID_ERRORS == 61 or DCGM_FI_DEV_XID_ERRORS == 62 or DCGM_FI_DEV_XID_ERRORS == 63 or DCGM_FI_DEV_XID_ERRORS == 64 or DCGM_FI_DEV_XID_ERRORS == 68 or DCGM_FI_DEV_XID_ERRORS == 74 or DCGM_FI_DEV_XID_ERRORS == 79 or DCGM_FI_DEV_XID_ERRORS == 92 or DCGM_FI_DEV_XID_ERRORS == 94 or DCGM_FI_DEV_XID_ERRORS == 95",
                    "query": "",
                    "ref": "A",
                    "severity": 2,
                    "unit": "none"
                }
            ],
            "version": "v1"
        },
        "event_relabel_config": null,
        "prom_eval_interval": 15,
        "enable_in_bg": 0,
        "notify_recovered": 1,
        "notify_repeat_step": 60,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "action": "1) 用 nvidia-smi -q -d PAGE_RETIREMENT,ECC 与 dmesg -T | grep -i xid 确认具体 XID 码和涉及的卡；\n2) 对照 NVIDIA XID 文档判断是软件（驱动/CUDA）还是硬件故障；\n3) Xid 48/63/64（ECC）与 79（掉卡）基本可判定硬件问题，先把该卡从调度池摘除（K8s 上给节点打 taint）；\n4) 软件类的升级驱动/CUDA 后复测，硬件类的走返修流程。"
        },
        "uuid": 1751791234000037,
        "cur_event_count": 0,
        "cron_pattern": "@every 60s",
        "notify_rule_ids": [],
        "pipeline_configs": null,
        "notify_version": 0
    },
    {
        "cate": "prometheus",
        "name": "GPU 温度过高",
        "note": "",
        "prod": "metric",
        "delay": 0,
        "prom_for_duration": 180,
        "rule_config": {
            "queries": [
                {
                    "prom_ql": "sum by (Hostname, modelName, gpu) (DCGM_FI_DEV_GPU_TEMP \u003e 85)",
                    "severity": 2,
                    "unit": "none"
                }
            ],
            "version": "v1"
        },
        "event_relabel_config": null,
        "prom_eval_interval": 15,
        "enable_in_bg": 0,
        "notify_recovered": 1,
        "notify_repeat_step": 60,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "action": "1) 用 nvidia-smi -q -d TEMPERATURE,PERFORMANCE 确认当前温度与是否已触发 SW/HW Slowdown；\n2) 检查机箱风道、风扇转速与滤网积灰，确认机房进风温度正常；\n3) 多卡机型确认是否所有卡都高温——单卡高温多为散热器接触或风扇问题；\n4) 短期可用 nvidia-smi -pl 降低功耗上限或降低任务并发，为停机除尘争取时间。"
        },
        "uuid": 1751791234000038,
        "cur_event_count": 0,
        "cron_pattern": "@every 60s",
        "notify_rule_ids": [],
        "pipeline_configs": null,
        "notify_version": 0
    }
]
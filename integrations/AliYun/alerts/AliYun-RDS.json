    {
        "cate": "prometheus",
        "name": "阿里云 RDS 数据库 MySQL/内存使用率告警",
        "note": "",
        "prod": "metric",
        "delay": 0,
        "prom_for_duration": 180,
        "rule_config": {
            "queries": [
                {
                    "prom_ql": "AliyunRds_MemoryUsage{engine=\"MySQL\"} \u003e 80",
                    "severity": 2,
                    "unit": "none"
                }
            ],
            "version": "v1"
        },
        "event_relabel_config": null,
        "prom_eval_interval": 15,
        "enable_in_bg": 0,
        "notify_recovered": 1,
        "notify_repeat_step": 60,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "summary": "云数据库实例内存使用率超过 80%，缓存命中率会下降、临时表落盘增多，继续增长可能触发实例重启。",
            "action": "1) 在控制台监控页确认内存增长趋势；2) MongoDB 类关注 WiredTiger cache 占比，MySQL 类关注 buffer pool 与连接内存（每连接的 sort/join buffer）；3) 排查是否有大结果集查询或过高的连接数在吃内存；4) 优化后仍不足的在控制台升配。",
            "runbook_url": "https://help.aliyun.com/product/28572.html"
        },
        "uuid": 1751791234000005,
        "cur_event_count": 0,
        "cron_pattern": "@every 60s",

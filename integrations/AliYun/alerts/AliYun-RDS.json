    {
        "cate": "prometheus",
        "name": "阿里云 RDS 数据库 MySQL/QPS波动率告警",
        "note": "",
        "prod": "metric",
        "delay": 0,
        "prom_for_duration": 180,
        "rule_config": {
            "queries": [
                {
                    "prom_ql": "100 * delta(AliyunRds_MySQL_QPS{}[5m]) / AliyunRds_MySQL_QPS{} offset 1m \u003e 30",
                    "severity": 2,
                    "unit": "none"
                }
            ],
            "version": "v1"
        },
        "event_relabel_config": null,
        "prom_eval_interval": 15,
        "enable_in_bg": 0,
        "notify_recovered": 1,
        "notify_repeat_step": 60,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "action": "1) 在控制台监控页确认 QPS 曲线的起跳时间点；\n2) 对照业务侧的发布记录与营销活动，确认是否为预期流量；\n3) 非预期的用慢日志/审计日志按来源统计，定位异常客户端并限流；\n4) 确认缓存层是否失效导致请求穿透到数据库。"
        },
        "uuid": 1751791234000003,
        "cur_event_count": 0,
        "cron_pattern": "@every 60s",
        "notify_rule_ids": [],
        "notify_version": 1
    },

    {
        "cate": "prometheus",
        "name": "阿里云 RDS 数据库 MySQL/总连接数告警",
        "note": "",
        "prod": "metric",
        "delay": 0,
        "prom_for_duration": 180,
        "rule_config": {
            "queries": [
                {
                    "prom_ql": "AliyunRds_MySQL_ThreadsConnected{} \u003e 1200",
                    "severity": 2,
                    "unit": "none"
                }
            ],
            "version": "v1"
        },
        "event_relabel_config": null,
        "prom_eval_interval": 15,
        "enable_in_bg": 0,
        "notify_recovered": 1,
        "notify_repeat_step": 60,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "summary": "云数据库实例连接数使用率超过 80%，触顶后新连接会被拒绝，应用直接报连接失败。",
            "action": "1) 在控制台看连接数曲线与实例规格上限；2) 用 SHOW PROCESSLIST（MySQL 类）或 db.currentOp()（MongoDB）按来源统计，找出连接异常的应用；3) 区分业务增长与应用连接池泄漏（大量空闲连接堆积）；4) 应急升配，根因侧收敛连接池上限并缩短空闲超时。",
            "runbook_url": "https://help.aliyun.com/product/28572.html"
        },
        "uuid": 1751791234000006,
        "cur_event_count": 0,
        "cron_pattern": "@every 60s",
        "notify_rule_ids": [],
        "notify_version": 1
    },

        "notify_repeat_step": 60,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "summary": "RDS MySQL 的复制线程（SlaveIO 或 SlaveSQL）不处于运行状态，只读实例数据停止更新，读流量会读到过期数据。",
            "action": "1) 在阿里云控制台的只读实例页确认复制状态与延迟；2) 控制台一般提供「修复复制」入口，优先使用；3) 因主实例 binlog 被清理导致的，只能重建只读实例；4) 恢复前把读流量从该只读实例切走。",
            "runbook_url": "https://help.aliyun.com/product/28572.html"
        },

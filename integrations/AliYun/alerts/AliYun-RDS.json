        "cate": "prometheus",
        "name": "阿里云 RDS 数据库 MySQL/运行状态异常告警",
        "note": "",
        "prod": "metric",
        "delay": 0,
        "prom_for_duration": 60,
        "rule_config": {
            "queries": [
                {
                    "prom_ql": "{__name__=~\"AliyunRds_MySQL_(SlaveIO|SlaveSQL)Running\"} != 1",
                    "severity": 1,
                    "unit": "none"
                }
            ],
            "version": "v1"
        },
        "event_relabel_config": null,

        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "action": "1) 在控制台的慢日志页按执行时长排序找出 TOP 慢 SQL；\n2) 用 EXPLAIN 看执行计划，重点消除全表扫描；\n3) 补索引或改写 SQL 后复测；\n4) 确认是否与近期上线的新功能相关，是则优先回滚该功能的查询。"
        },
        "uuid": 1751791234000007,
        "cur_event_count": 0,

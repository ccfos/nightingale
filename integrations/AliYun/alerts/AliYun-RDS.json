        "rule_config": {
            "queries": [
                {
                    "prom_ql": "100 * max(AliyunRds_MySQL_SlowQueries) by (instanceId, instanceName, regionId) / max(AliyunRds_MySQL_QPS) by (instanceId, instanceName, regionId) \u003e 1",
                    "severity": 2,
                    "unit": "none"
                }
            ],
            "version": "v1"
        },
        "event_relabel_config": null,
        "prom_eval_interval": 15,
        "enable_in_bg": 0,
        "notify_recovered": 1,
        "notify_repeat_step": 60,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "summary": "慢查询数量明显上升，慢 SQL 会长时间占住连接与 IO，并发上来后容易连锁拖垮实例。",
            "action": "1) 在控制台的慢日志页按执行时长排序找出 TOP 慢 SQL；2) 用 EXPLAIN 看执行计划，重点消除全表扫描；3) 补索引或改写 SQL 后复测；4) 确认是否与近期上线的新功能相关，是则优先回滚该功能的查询。",
            "runbook_url": "https://help.aliyun.com/product/28572.html"
        },
        "uuid": 1751791234000007,
        "cur_event_count": 0,
        "cron_pattern": "@every 60s",

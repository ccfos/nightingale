[
    {
        "cate": "prometheus",
        "name": "阿里云 RDS 数据库 MySQL/CPU使用率告警",
        "note": "",
        "prod": "metric",
        "delay": 0,
        "prom_for_duration": 180,
        "rule_config": {
            "queries": [
                {
                    "prom_ql": "AliyunRds_CpuUsage{engine=\"MySQL\"} \u003e 80",
                    "severity": 2,
                    "unit": "none"
                }
            ],
            "version": "v1"
        },
        "event_relabel_config": null,
        "prom_eval_interval": 15,
        "enable_in_bg": 0,
        "notify_recovered": 1,
        "notify_repeat_step": 60,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "action": "1) 在阿里云控制台的实例监控页确认 CPU 曲线是持续还是突发；\n2) 用控制台自带的「一键诊断」或慢日志找出消耗 CPU 最高的 SQL；\n3) 对慢 SQL 补索引、消除全表扫描，这是最有效的手段；\n4) 优化后仍高的在控制台变更实例规格，注意变配会有短暂闪断。"
        },
        "uuid": 1751791234000001,
        "cur_event_count": 0,
        "cron_pattern": "@every 60s",
        "notify_rule_ids": [],
        "notify_version": 1
    },

[
    {
        "cate": "prometheus",
        "name": "阿里云 Redis CPU使用率告警",
        "note": "",
        "prod": "metric",
        "delay": 0,
        "prom_for_duration": 180,
        "rule_config": {
            "queries": [
                {
                    "prom_ql": "label_replace({__name__=~\"AliyunKvstore_(Standard|Sharding|ShardingProxy|Splitrw|SplitrwProxy)CpuUsage\"},\"redisType\",\"$1\",\"measure\",\"(.+)CpuUsage\") \u003e 80",
                    "severity": 2,
                    "unit": "none"
                }
            ],
            "version": "v1"
        },
        "event_relabel_config": null,
        "prom_eval_interval": 15,
        "enable_in_bg": 0,
        "notify_recovered": 1,
        "notify_repeat_step": 60,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "action": "1) 在控制台的「性能监控」看 CPU 曲线，并用「实时 Key 分析」找热 key；\n2) 用慢日志找 O(N) 命令（KEYS、HGETALL、大范围 ZRANGE）并改造；\n3) 大 key 拆分是最有效的优化手段；\n4) 优化后仍高的在控制台升配或改用集群版分摊。"
        },
        "uuid": 1751791234000012,
        "cur_event_count": 0,
        "cron_pattern": "@every 60s",
        "notify_rule_ids": [],
        "notify_version": 1
    },

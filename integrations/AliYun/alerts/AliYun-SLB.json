    {
        "cate": "prometheus",
        "name": "阿里云 SLB 4XX 占比告警 超过10%",
        "note": "",
        "prod": "metric",
        "delay": 0,
        "prom_for_duration": 300,
        "rule_config": {
            "queries": [
                {
                    "prom_ql": "100 * AliyunSlb_InstanceStatusCode4xx{} / on(loadBalancerId) group_left sum({__name__=~\"AliyunSlb_InstanceStatusCode.+\"}) by (loadBalancerId,loadBalancerName,regionId) \u003e 10",
                    "severity": 2,
                    "unit": "none"
                }
            ],
            "version": "v1"
        },
        "event_relabel_config": null,
        "prom_eval_interval": 15,
        "enable_in_bg": 0,
        "notify_recovered": 1,
        "notify_repeat_step": 60,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "summary": "负载均衡 4xx 占比超过 10%，大量请求被判定为客户端错误，可能是接口变更、鉴权问题或异常扫描流量。",
            "action": "1) 在控制台看 4xx 的具体分布，确认是 404 还是 403/401 为主；2) 404 突增多为前端引用了已下线的接口，核对发布记录；3) 403/401 突增排查鉴权配置变更或凭据过期；4) 疑似扫描流量的接入 WAF 做拦截。",
            "runbook_url": "https://help.aliyun.com/product/28572.html"
        },
        "uuid": 1751791234000024,
        "cur_event_count": 0,
        "cron_pattern": "@every 60s",
        "notify_rule_ids": [],
        "notify_version": 1
    },

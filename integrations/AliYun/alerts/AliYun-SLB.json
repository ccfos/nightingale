        "annotations": {
            "action": "1) 在控制台看 4xx 的具体分布，确认是 404 还是 403/401 为主；\n2) 404 突增多为前端引用了已下线的接口，核对发布记录；\n3) 403/401 突增排查鉴权配置变更或凭据过期；\n4) 疑似扫描流量的接入 WAF 做拦截。"
        },
        "uuid": 1751791234000024,
        "cur_event_count": 0,
        "cron_pattern": "@every 60s",
        "notify_rule_ids": [],
        "notify_version": 1
    },

        "annotations": {
            "summary": "Oracle 进程数超过 500，接近 processes 参数上限时新连接会被拒绝并报 ORA-00020。",
            "action": "1) 用 SELECT COUNT(*) FROM V$PROCESS 与 SHOW PARAMETER processes 对比当前水位与上限；2) 用 SELECT machine, program, COUNT(*) FROM V$SESSION GROUP BY 1,2 ORDER BY 3 DESC 找出连接数异常的应用；3) 区分业务增长与应用连接池泄漏（大量 INACTIVE 会话堆积）；4) 应急可调大 processes 参数（需重启实例），根因侧收敛应用连接池上限。",
            "runbook_url": "https://docs.oracle.com/en/database/oracle/oracle-database/19/admin/index.html"
        },

[
    {
        "cate": "prometheus",
        "name": "DNS 响应状态码异常",
        "note": "",
        "prod": "metric",
        "delay": 0,
        "prom_for_duration": 60,
        "rule_config": {
            "queries": [
                {
                    "prom_ql": "dns_query_rcode_value != 0",
                    "severity": 2,
                    "unit": "none"
                }
            ],
            "version": "v1"
        },
        "event_relabel_config": null,
        "prom_eval_interval": 15,
        "enable_in_bg": 0,
        "notify_recovered": 1,
        "notify_repeat_step": 60,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "action": "1) 在采集机上手工 dig @\u003cDNS服务器\u003e \u003c域名\u003e 复现，看 status 与耗时；\n2) 换用公共 DNS（如 dig @223.5.5.5）对比，区分是 DNS 服务器问题还是域名本身问题；\n3) 自建 DNS 的检查服务进程、上游转发配置与网络连通性；\n4) 确认探测配置里的域名、记录类型、超时设置是否合理，避免配置导致误报。"
        },
        "uuid": 1751791234000033,
        "cur_event_count": 0,
        "cron_pattern": "@every 60s",
        "notify_rule_ids": [],
        "pipeline_configs": null,
        "notify_version": 1
    },

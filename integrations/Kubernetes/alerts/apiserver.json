        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "runbook_url": "",
        "append_tags": [],
        "annotations": {
            "summary": "聚合 API（APIService）不可用，依赖它的功能完全失效——例如 metrics-server 挂了会导致 kubectl top 与 HPA 全部失灵。",
            "action": "1) kubectl get apiservice 确认是哪个 APIService；2) kubectl -n \u003cns\u003e get pod 检查其后端 Pod 是否健康；3) 查看该 Pod 日志定位启动或运行错误；4) 恢复后用 kubectl top node 之类命令验证功能已回来。"
        },
        "extra_config": null,
        "create_at": 0,
        "create_by": "",
        "update_at": 0,
        "update_by": "",
        "uuid": 1717556327605135000

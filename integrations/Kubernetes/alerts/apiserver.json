        "algo_params": null,
        "delay": 0,
        "severity": 2,
        "severities": null,
        "disabled": 0,
        "prom_for_duration": 300,
        "prom_ql": "(1 - max by(name, namespace)(avg_over_time(aggregator_unavailable_apiservice[10m]))) * 100 \u003c 85\n",
        "rule_config": null,
        "prom_eval_interval": 15,
        "enable_stime": "00:00",
        "enable_stimes": null,
        "enable_etime": "23:59",
        "enable_etimes": null,

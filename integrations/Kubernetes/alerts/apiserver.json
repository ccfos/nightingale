        "notify_recovered": 1,
        "notify_channels": [],
        "notify_groups_obj": null,
        "notify_groups": null,
        "notify_repeat_step": 60,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "runbook_url": "",
        "append_tags": [
            "long=1h",
            "short=5m"
        ],
        "annotations": {
            "summary": "apiserver 的错误预算消耗速率过快，说明请求错误率或延迟已明显偏离 SLO，集群控制面正在劣化。",
            "action": "1) 看 apiserver 的错误码与延迟分布，确认是读还是写请求在劣化；2) 写请求劣化优先排查 etcd 的磁盘延迟——这是最常见根因；3) 读请求劣化排查是否有客户端在做大范围 LIST（无 resourceVersion 的全量列举）；4) 定位到异常客户端的对其限流，并考虑开启 APF（API Priority and Fairness）。",
            "runbook_url": "https://runbooks.prometheus-operator.dev/runbooks/kubernetes/kubeapierrorbudgetburn/"
        },
        "extra_config": null,
        "create_at": 0,
        "create_by": "",
        "update_at": 0,
        "update_by": "",
        "uuid": 1717556327608028000
    },

        "callbacks": [],
        "runbook_url": "",
        "append_tags": [],
        "annotations": {
            "action": "1) kubectl describe node \u003cnode\u003e 看 Conditions 的变更时间线；\n2) 登录节点看 kubelet 日志，常见根因是资源压力、容器运行时卡顿、或到 apiserver 的网络不稳；\n3) 抖动期间建议先 kubectl cordon 该节点，阻止新 Pod 调度上去；\n4) 根因定位并修复后再 uncordon，不要在抖动中反复重启 kubelet。"
        },
        "extra_config": null,
        "create_at": 0,
        "create_by": "",
        "update_at": 0,
        "update_by": "",
        "uuid": 1717556327641505000
    },
    {

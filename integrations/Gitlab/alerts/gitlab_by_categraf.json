        "annotations": {
            "summary": "GitLab 的 PostgreSQL 发生死锁，PostgreSQL 会主动回滚其中一个事务，对应的 GitLab 操作直接失败。",
            "action": "1) 在 PG 上确认 log_lock_waits=on，从日志里取死锁双方的完整 SQL；2) 关联 pg_locks 与 pg_stat_activity 确认是哪两张表互相等待；3) GitLab 场景常见于 CI 并发更新同一批记录——降低并发或升级 GitLab 版本（上游常修此类问题）；4) 检查是否有长事务放大了死锁概率。",
            "runbook_url": "https://docs.gitlab.com/administration/monitoring/"
        },
        "extra_config": null,
        "create_at": 0,
        "create_by": "",
        "update_at": 0,
        "update_by": "",

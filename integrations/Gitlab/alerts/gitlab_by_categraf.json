        "annotations": {
            "summary": "Gitaly 的 gRPC 调用出现大量 ResourceExhausted，说明 Gitaly 侧的并发限流已经打满，Git 操作（clone/push/CI 拉代码）会开始失败。",
            "action": "1) 在 Gitaly 节点看日志确认是哪类 RPC 被限流（gitaly_concurrency_limiting 相关）；2) 用 gitlab-ctl status 与节点 CPU/IO 确认 Gitaly 是否已过载；3) 定位是否有超大仓库或异常客户端在反复拉取，必要时临时限制该来源；4) 容量确实不足则调大 Gitaly 的并发限制并扩容节点。",
            "runbook_url": "https://docs.gitlab.com/administration/monitoring/"
        },
        "extra_config": null,
        "create_at": 0,
        "create_by": "",
        "update_at": 0,

                    "unit": "%"
                }
            ],
            "version": "v1"
        },
        "event_relabel_config": null,
        "prom_eval_interval": 15,
        "enable_in_bg": 0,
        "notify_recovered": 1,
        "notify_repeat_step": 60,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "action": "1) 用 smartctl -a /dev/sdX 确认 Media_Wearout_Indicator / Percentage_Used 与 Total_LBAs_Written；\n2) 结合写入速率估算剩余寿命，据此排换盘窗口；\n3) 确认该盘上的数据有副本，并提前准备迁移方案；\n4) 复盘写入放大来源（日志级别、频繁小写入、无 TRIM），避免新盘重蹈覆辙。"
        },
        "uuid": 1719305153888541030,
        "cur_event_count": 0,
        "cron_pattern": "@every 30s",

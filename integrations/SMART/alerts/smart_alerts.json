                    "prom_ql": "increase(smart_attribute_crc_error_count[1h]) \u003e 0",
                    "severity": 1,
                    "unit": "none"
                }
            ],
            "version": "v1"
        },
        "event_relabel_config": null,
        "prom_eval_interval": 15,
        "enable_in_bg": 0,
        "notify_recovered": 1,
        "notify_repeat_step": 60,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "action": "1) 用 smartctl -a /dev/sdX 确认 UDMA_CRC_Error_Count 的增长速度；\n2) 停机检查并重新插拔 SATA/SAS 数据线与电源线，优先直接换一根线；\n3) 换线后观察计数是否停止增长——SMART 计数不会自动归零，看增量而非绝对值；\n4) 换线无效则怀疑背板或 HBA 卡，逐个替换定位。"
        },
        "uuid": 1719305153888541032,
        "cur_event_count": 0,
        "cron_pattern": "@every 30s",
        "notify_rule_ids": [],
        "pipeline_configs": null,

        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "action": "1) 用 smartctl -a /dev/sdX 确认温度与厂商标称的工作温度上限；\n2) 检查机箱风道、风扇转速与滤网积灰，机房环境温度是否正常；\n3) 确认盘位安装位置是否过于密集、相邻盘是否同样高温；\n4) 短期可降低该盘的 IO 压力（错峰备份、迁移热数据）为处理争取时间。"
        },
        "uuid": 1719305153888541031,
        "cur_event_count": 0,

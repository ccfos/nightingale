[
    {
        "cate": "prometheus",
        "name": "SMART设备健康状态异常",
        "note": "硬盘自身检测的整体健康状态为不健康，存在严重故障风险，需立即处理",
        "prod": "metric",
        "delay": 0,
        "prom_for_duration": 60,
        "rule_config": {
            "inhibit": false,
            "queries": [
                {
                    "keys": {
                        "labelKey": "",
                        "metricKey": "",
                        "valueKey": ""
                    },
                    "prom_ql": "smart_device_health_ok == 0",
                    "severity": 1,
                    "unit": "none"
                }
            ],
            "version": "v1"
        },
        "event_relabel_config": null,
        "prom_eval_interval": 15,
        "enable_in_bg": 0,
        "notify_recovered": 1,
        "notify_repeat_step": 60,
        "notify_max_number": 0,
        "recover_duration": 0,
        "callbacks": [],
        "append_tags": [],
        "annotations": {
            "action": "1) 用 smartctl -a /dev/sdX 看完整属性，重点关注 Reallocated_Sector_Ct、Current_Pending_Sector、Offline_Uncorrectable；\n2) 立即确认该盘上的数据有副本或已备份——这是最优先的动作；\n3) RAID 环境下确认阵列状态，先让阵列把该盘踢出并用热备重建；\n4) 安排停机换盘，不要继续往这块盘写数据。"
        },
        "uuid": 1719305153888541029,
        "cur_event_count": 0,
        "cron_pattern": "@every 30s",
        "notify_rule_ids": [],
        "pipeline_configs": null,
        "notify_version": 0
    },
    {
        "cate": "prometheus",

        "callbacks": [],
        "runbook_url": "",
        "append_tags": [],
        "annotations": {
            "action": "1) 在 postgresql.conf 里确认 log_lock_waits=on、deadlock_timeout 合理，然后从日志里取死锁双方的完整 SQL；\n2) 查 pg_locks 与 pg_stat_activity 关联，确认是哪两张表、哪种锁互相等待；\n3) 根因通常是不同事务以相反顺序更新同几行——统一业务侧的加锁顺序即可消除；\n4) 长事务会放大死锁概率，检查是否有事务开启后长时间不提交。"
        },
        "extra_config": null,
        "create_at": 0,

        "note": "",
        "prod": "metric",
        "algorithm": "",
        "algo_params": null,
        "delay": 0,
        "severity": 0,
        "severities": [
            2
        ],
        "disabled": 1,
        "prom_for_duration": 60,
        "prom_ql": "",
        "rule_config": {

        "name": "posgresql读取时间过高",
        "note": "数据库中花费在读取文件的时间，这个值很高说明内存较小，需要频繁从磁盘读入数据文件",
        "prod": "metric",
        "algorithm": "",
        "algo_params": null,
        "delay": 0,
        "severity": 0,
        "severities": [
            2
        ],
        "disabled": 1,
        "prom_for_duration": 60,
        "prom_ql": "",
        "rule_config": {
            "queries": [
                {
                    "prom_ql": "rate(postgresql_blk_read_time[5m]) \u003e 100",
                    "severity": 2
                }
            ]
        },
        "prom_eval_interval": 30,
        "enable_stime": "00:00",
        "enable_stimes": [
            "00:00"

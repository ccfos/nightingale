        "note": "数据库中花费在写数据文件的时间，pg中脏页一般写入page cache，如果这个值较高，则说明cache较小，操作系统的cache需要更积极的写入",
        "prod": "metric",
        "algorithm": "",
        "algo_params": null,
        "delay": 0,
        "severity": 0,
        "severities": [
            2
        ],
        "disabled": 1,
        "prom_for_duration": 60,
        "prom_ql": "",
        "rule_config": {
            "queries": [
                {
                    "prom_ql": "rate(postgresql_blk_write_time[5m]) \u003e 100",
                    "severity": 2
                }
            ]
        },
        "prom_eval_interval": 30,
        "enable_stime": "00:00",
        "enable_stimes": [
            "00:00"
        ],
        "enable_etime": "23:59",
        "enable_etimes": [
            "23:59"
        ],
        "enable_days_of_week": [

        "name": "Cloudflare 缓存命中率较昨日同期显著下降",
        "note": "该规则用昨日同一时段作为基线做同比，不设固定阈值，避免不同站点缓存率差异导致的误报；Zone 刚上线不足 24 小时时该规则不会产生数据。",
        "prod": "metric",
        "algorithm": "",
        "algo_params": null,
        "delay": 0,
        "severity": 2,
        "severities": [
            2
        ],
        "disabled": 1,
        "prom_for_duration": 900,
        "prom_ql": "",
        "rule_config": {
            "algo_params": null,
            "inhibit": false,
            "prom_ql": "",
            "queries": [
                {
                    "prom_ql": "sum by (zone) (rate(cloudflare_zone_requests_cached[1h])) / (sum by (zone) (rate(cloudflare_zone_requests_total[1h])) \u003e 0) \u003c 0.7 * (sum by (zone) (rate(cloudflare_zone_requests_cached[1h] offset 1d)) / (sum by (zone) (rate(cloudflare_zone_requests_total[1h] offset 1d)) \u003e 0))",
                    "severity": 2
                }
            ],
            "severity": 0
        },
        "prom_eval_interval": 15,
        "enable_stime": "00:00",
        "enable_stimes": [
